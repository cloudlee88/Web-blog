# ---------------------------------------------------------------------------
# Cloudhub (CloudPixel) — environment variables
# Copy to `.env` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon free tier recommended).
# Neon: create a project -> copy the "Pooled connection" string.
# The app runs without this set (empty states); set it + seed to get real data.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Protects /admin and POST /api/content. Use a long random string.
# Generate one: `openssl rand -base64 32`
ADMIN_SECRET="change-me-to-a-long-random-string"

# Email Service Provider (ConvertKit or Brevo). Optional at MVP.
# ConvertKit: API key + form id. Brevo: API key + list id.
ESP_PROVIDER=""        # "convertkit" | "brevo" | "" (disabled)
ESP_API_KEY=""
ESP_FORM_ID=""         # ConvertKit form id
ESP_LIST_ID=""         # Brevo list id

# Public analytics + canonical URL (used in metadata, sitemap, OG).
NEXT_PUBLIC_GA_ID=""                         # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_SITE_URL="http://localhost:3000" # set to https://cloudpixel.com in prod
