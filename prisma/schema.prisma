// CloudPixel — Prisma schema (v2.1)
// See docs/TechStack_final.md §5 for the source data model.
// DB-backed + API-writable: content is created via /api/content and admin CRUD,
// never as hand-committed files (keeps the automation vision open — TechStack §8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Pricing {
  FREE
  FREEMIUM
  PAID
}

enum PostType {
  BLOG
  TUTORIAL
  NEWS
  REVIEW
}

/// A reviewed product (AI tool / tool / digital product). The core entity.
model Tool {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  logoUrl       String?
  screenshotUrl String?
  shortDesc     String // one-line description shown on cards

  // Editorial signal
  rating        Float    @default(0) // 0.0 – 5.0
  pricing       Pricing  @default(FREEMIUM)
  editorialRank Int? // lower = higher rank; set by admin (FR-4.1)
  featured      Boolean  @default(false)
  verified      Boolean  @default(false) // "Tested/Verified" badge (FR-2.4)

  // Deep-review content (the differentiator — PDR §4.3)
  verdict     String? @db.Text // 2–3 sentence quick verdict
  reviewBody  String? @db.Text // long-form markdown, rendered server-side
  pros        String[]
  cons        String[]
  useCases    String[]
  pricingTiers Json? // [{ name, price, features: string[] }]
  faq         Json? // [{ q, a }]

  // Affiliate — links always go through /go/[slug] (never inline)
  affiliateSlug String?
  website       String? // official, non-affiliate reference URL

  // SEO (FR-7.1) — independent of the display name
  metaTitle       String?
  metaDescription String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]     @relation("ToolTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([editorialRank])
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text // SEO intro shown on the category page
  tools       Tool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  tools Tool[] @relation("ToolTags")

  createdAt DateTime @default(now())
}

/// Cloaked affiliate destination. Resolved by GET /go/[slug].
model AffiliateLink {
  id         String  @id @default(cuid())
  slug       String  @unique
  targetUrl  String
  network    String? // Impact / PartnerStack / ShareASale / direct
  couponCode String?
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Anonymous click log — powers "trending" (FR-4.2). No raw IP, hashed UA only.
model ClickLog {
  id            String   @id @default(cuid())
  affiliateSlug String
  referrer      String?
  userAgentHash String?
  createdAt     DateTime @default(now())

  @@index([affiliateSlug])
  @@index([createdAt])
}

/// Blog / Tutorial / News (markdown in DB). FR-5.x
model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  type            PostType  @default(BLOG)
  topic           String?   // review sub-category slug (lifestyle, beauty-fashion, entertainment)
  categorySlug    String?   // editorial pillar/section: "buying-guides" (Best Guides); null = blog
  excerpt         String?   @db.Text
  coverUrl        String?
  body            String    @db.Text // markdown
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([topic])
  @@index([categorySlug])
  @@index([publishedAt])
}

/// Backup copy of newsletter subscribers; ESP is the source of truth.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Best-of buying guide (v2.1 §3.1): a ranked list of tools for a commercial
/// query ("Best AI X 2026"). `items` references tools by slug so guides are
/// easy to author; the page resolves each slug to a live Tool at render time.
model Guide {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  intro           String?  @db.Text // markdown
  items           Json // [{ toolSlug, rank, miniVerdict, score }]
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}
